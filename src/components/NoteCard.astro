---
import type { NoteEntry } from "@/utils/knowledge";
import { noteUrl } from "@/utils/knowledge";
import { slugifyStr } from "@/utils/slugify";
import { BASE_PATH } from "@/site.config";
import KindBadge from "./KindBadge.astro";

type Props = {
  note: NoteEntry;
  featured?: boolean;
  index?: number;
};

const { note, featured = false, index = 0 } = Astro.props;
const { title, description, tags, kind, pubDatetime, modDatetime } = note.data;
const accent = ["var(--coral)", "var(--violet)", "var(--teal)", "var(--tangerine)", "var(--rose)"][index % 5];
const date = (modDatetime ?? pubDatetime).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<article
  class:list={["garden-card", { "featured-card": featured }]}
  style={`--card-accent:${accent}`}
>
  <div class="card-top">
    <KindBadge kind={kind} />
    <time datetime={(modDatetime ?? pubDatetime).toISOString()}>{date}</time>
  </div>

  <h3 class="card-title">
    <a href={noteUrl(note.id)}>{title}</a>
  </h3>
  <p class="card-desc">{description}</p>

  <div class="card-bottom">
    <div class="tag-row">
      {tags.slice(0, 3).map(tag => (
        <a href={`${BASE_PATH}/tags/${slugifyStr(tag)}/`}>#{tag}</a>
      ))}
    </div>
    <a class="read-link" href={noteUrl(note.id)} aria-label={`Read ${title}`}>
      阅读 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .card-top,
  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .card-top time {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .card-title {
    margin: 1.15rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .featured-card .card-title { font-size: 1.8rem; }
  .card-title a { color: var(--foreground); text-decoration: none; }
  .card-title a:hover { color: var(--accent); }
  .card-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted-foreground);
    min-height: 3.1em;
  }
  .card-bottom { margin-top: 1.4rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .tag-row a {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }
  .tag-row a:hover { color: var(--accent); }
  .read-link {
    font-family: var(--font-accent);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
