---
import profile from "@/data/profile.json";
import { BASE_PATH } from "@/site.config";

const year = new Date().getFullYear();
const links = [
  { href: `${BASE_PATH}/notes/`, label: "Notes" },
  { href: `${BASE_PATH}/projects/`, label: "Projects" },
  { href: `${BASE_PATH}/resume/`, label: "Resume" },
  { href: `${BASE_PATH}/about/`, label: "About" },
  { href: `${BASE_PATH}/now/`, label: "Now" },
];
---

<footer class="app-layout mt-auto pb-10 pt-16">
  <div class="border-border flex flex-col gap-8 border-t pt-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="accent-script text-4xl">See you in the garden</p>
      <p class="mt-2 text-sm text-muted-foreground">
        © {year} {profile.name}. Grown with Markdown, curiosity and care.
      </p>
      <p class="mt-1 text-xs text-muted-foreground">{profile.placeholderNotice}</p>
    </div>

    <div class="flex flex-col items-start gap-4 md:items-end">
      <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {links.map(link => (
          <a class="link-dainty" href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {profile.socials.map(social => (
          <a class="link-dainty" href={social.url} rel="noopener noreferrer" target="_blank">
            {social.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .link-dainty {
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 5px;
    transition: color 180ms ease;
  }
  .link-dainty:hover,
  .link-dainty:focus-visible {
    color: var(--accent);
  }
</style>
