---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import profile from "@/data/profile.json";
import { BASE_PATH } from "@/site.config";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing src/content/pages/about.md");
const { Content } = await render(about);
---

<Layout
  page="about"
  title="About — A Living Garden"
  description={about.data.description}
>
  <Header />
  <main id="main-content" class="app-layout flex-1 pt-14 pb-24">
    <div class="about-hero">
      <div>
        <p class="eyebrow">Behind the garden</p>
        <h1 class="display about-title">
          About<span class="accent-script title-script">a little context</span>
        </h1>
        <p class="hand-cn about-cn">关于这个空间，也关于正在生长的人</p>
      </div>
      <div class="portrait" aria-hidden="true">
        <div class="portrait-shape"></div>
        <span class="portrait-script">still growing</span>
        <span class="portrait-initial">{profile.monogram}.</span>
      </div>
    </div>

    <div class="about-grid">
      <aside class="about-aside glass">
        <p class="eyebrow">At a glance</p>
        <dl>
          <div><dt>Name</dt><dd>{profile.name} / {profile.nameZh}</dd></div>
          <div><dt>Role</dt><dd>{profile.role}</dd></div>
          <div><dt>Based in</dt><dd>{profile.location}</dd></div>
          <div>
            <dt>Elsewhere</dt>
            <dd>
              {
                profile.socials.map(social => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {social.label} ↗
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
        <a class="resume-link" href={`${BASE_PATH}/resume/`}>查看履历 →</a>
      </aside>

      <article class="app-prose about-body prose-layout">
        <Content />
      </article>
    </div>

    <section class="values mt-20">
      <p class="eyebrow">Things I keep returning to</p>
      <div class="value-row">
        <span>好奇心</span><span>修订</span><span>缓慢</span><span>连接</span
        ><span>诚实</span>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-hero {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .about-title {
    position: relative;
    margin-top: 0.7rem;
    font-size: clamp(4rem, 12vw, 9rem);
  }
  .title-script {
    position: absolute;
    right: -2rem;
    bottom: -0.2em;
    font-size: clamp(2rem, 5vw, 4rem);
    transform: rotate(-6deg);
    white-space: nowrap;
  }
  .about-cn {
    margin-top: 1.6rem;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    color: var(--accent);
  }
  .portrait {
    position: relative;
    min-height: 17rem;
    border-radius: 1.8rem;
    overflow: hidden;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--rose) 32%, var(--background)),
      color-mix(in srgb, var(--violet) 20%, var(--background))
    );
    border: 1px solid var(--border);
  }
  .portrait-shape {
    position: absolute;
    width: 20rem;
    height: 20rem;
    right: -4rem;
    top: -7rem;
    border-radius: 58% 42% 36% 64%;
    background: radial-gradient(
      circle at 30% 30%,
      color-mix(in srgb, var(--tangerine) 70%, transparent),
      transparent 65%
    );
    mix-blend-mode: multiply;
    opacity: 0.75;
  }
  .portrait-initial {
    position: absolute;
    left: 2rem;
    bottom: -2.5rem;
    font-family: var(--font-display);
    font-size: 13rem;
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--foreground) 16%, transparent);
  }
  .portrait-script {
    position: absolute;
    right: 1.8rem;
    bottom: 1.4rem;
    font-family: var(--font-accent);
    font-size: 2.6rem;
    color: var(--accent);
  }

  .about-grid {
    display: grid;
    gap: 3rem;
    margin-top: 4rem;
    align-items: start;
  }
  .about-aside {
    border-radius: 1.4rem;
    padding: 1.6rem;
  }
  .about-aside dl {
    margin-top: 1rem;
    display: grid;
    gap: 1.1rem;
  }
  .about-aside dt {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 0.88rem;
    letter-spacing: 0;
    color: var(--muted-foreground);
  }
  .about-aside dd {
    margin-top: 0.2rem;
    font-family: var(--font-editorial);
    font-size: 0.94rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .about-aside a {
    color: var(--accent);
    text-decoration: underline dotted;
    text-underline-offset: 4px;
  }
  .resume-link {
    display: inline-block;
    margin-top: 1.6rem;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .about-body {
    width: 100%;
  }
  .about-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.9rem;
    margin-top: 2.4rem;
  }
  .values {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .value-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.2rem;
  }
  .value-row span {
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--border));
    font-family: var(--font-hand-cn);
    font-size: 1.2rem;
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .about-hero {
      grid-template-columns: 1.25fr 0.75fr;
    }
    .about-grid {
      grid-template-columns: 17rem minmax(0, 1fr);
    }
  }
</style>
