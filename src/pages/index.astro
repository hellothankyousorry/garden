---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NoteCard from "@/components/NoteCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getPublishedNotes, getPublishedProjects, noteUrl } from "@/utils/knowledge";
import profile from "@/data/profile.json";
import now from "@/data/now.json";
import { BASE_PATH } from "@/site.config";

const notes = await getPublishedNotes();
const projects = await getPublishedProjects();
const recentNotes = notes.slice(0, 4);
const featuredProjects = projects.filter(project => project.data.featured).slice(0, 2);
const nameParts = profile.name.trim().split(/\s+/);
const firstName = nameParts[0] ?? "Your";
const lastName = nameParts.slice(1).join(" ") || "Name";

const paths = [
  { href: `${BASE_PATH}/notes/`, label: "Notes", zh: "笔记与思考", note: `${notes.length} notes growing` },
  { href: `${BASE_PATH}/projects/`, label: "Projects", zh: "实践与作品", note: `${projects.length} experiments` },
  { href: `${BASE_PATH}/resume/`, label: "Resume", zh: "履历与轨迹", note: "a timeline" },
  { href: `${BASE_PATH}/now/`, label: "Now", zh: "此刻正在", note: "updated often" },
];
---

<Layout page="home" title={`${profile.name} — ${profile.taglineEn}`} description={profile.intro}>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="app-layout hero-stage" aria-labelledby="hero-title">
      <div class="hero-orbit" aria-hidden="true">
        <span class="hero-node" style="top:18%;left:24%"></span>
        <span class="hero-node" style="top:62%;left:78%;background:var(--violet)"></span>
        <span class="hero-node" style="top:84%;left:38%;background:var(--teal)"></span>
      </div>

      <div class="floating-note one glass" aria-hidden="true">
        <span class="accent-script text-2xl">ideas</span><br />
        在这里，未完成的想法也有位置。
      </div>
      <div class="floating-note two glass" aria-hidden="true">
        <span class="hand-cn text-xl">慢慢生长</span><br />
        <span class="text-xs text-muted-foreground">garden log · {new Date().getUTCFullYear()}</span>
      </div>

      <div class="hero-copy">
        <p class="eyebrow">A living digital garden · 001</p>
        <h1 id="hero-title" class="hero-title display">
          <span class="line">{firstName}</span>
          <span class="line line-two display-italic">{lastName}</span>
        </h1>
        <p class="hero-cn hand-cn mt-4">{profile.taglineZh}</p>
        <p class="hero-script accent-script" aria-hidden="true">hello, curious one</p>
        <p class="mt-7 max-w-xl text-sm leading-7 text-muted-foreground sm:text-base">
          {profile.intro}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a class="primary-cta" href={noteUrl(notes[0]?.id ?? "a-garden-of-thoughts")}>
            进入花园 <span aria-hidden="true">↗</span>
          </a>
          <a class="secondary-cta" href={`${BASE_PATH}/about/`}>关于这里</a>
        </div>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>scroll to wander</span>
        <span class="cue-line"></span>
      </div>
    </section>

    <section class="app-layout py-14" aria-labelledby="now-title">
      <div class="glass now-strip">
        <div>
          <p class="eyebrow">Now · 此刻</p>
          <h2 id="now-title" class="mt-2 text-lg font-medium">{now.items[0]?.title}</h2>
        </div>
        <p class="text-sm text-muted-foreground">{now.items[0]?.detail}</p>
        <a class="now-link" href={`${BASE_PATH}/now/`}>查看此刻 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="app-layout py-10" aria-labelledby="paths-title">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Wander paths</p>
          <h2 id="paths-title" class="section-title mt-2">从哪里开始探索？</h2>
        </div>
        <span class="accent-script hidden text-3xl sm:block" aria-hidden="true">pick a thread</span>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {paths.map((path, index) => (
          <a class="path-card" href={path.href} style={`--path-accent:${["var(--coral)","var(--violet)","var(--teal)","var(--sky)"][index]}`}>
            <span class="path-number">0{index + 1}</span>
            <span class="path-label">{path.label}</span>
            <span class="hand-cn path-zh">{path.zh}</span>
            <span class="path-note">{path.note}</span>
            <span class="path-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="app-layout py-16" aria-labelledby="recent-title">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Freshly grown</p>
          <h2 id="recent-title" class="section-title mt-2">最近的笔记</h2>
        </div>
        <a class="quiet-link" href={`${BASE_PATH}/notes/`}>全部笔记 <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {recentNotes.map((note, index) => <NoteCard note={note} featured={index === 0} index={index} />)}
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="app-layout py-16" aria-labelledby="projects-title">
          <div class="mb-8 flex items-end justify-between gap-4">
            <div>
              <p class="eyebrow">Selected work</p>
              <h2 id="projects-title" class="section-title mt-2">精选项目</h2>
            </div>
            <a class="quiet-link" href={`${BASE_PATH}/projects/`}>全部项目 <span aria-hidden="true">→</span></a>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            {featuredProjects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        </section>
      )
    }

    <section class="app-layout pb-20 pt-10" aria-label="Garden connections">
      <div class="garden-map paper-card">
        <div class="map-copy">
          <p class="eyebrow">The garden is connected</p>
          <h2 class="section-title mt-2">思想在这里彼此遇见</h2>
          <p class="mt-4 max-w-lg text-sm leading-7 text-muted-foreground">
            笔记可以链接笔记，项目可以引用笔记，种子可以长成常青。
            你不需要按目录阅读——沿着好奇心走就好。
          </p>
          <a class="quiet-link mt-6 inline-block" href={`${BASE_PATH}/tags/`}>按标签漫游 <span aria-hidden="true">→</span></a>
        </div>
        <svg class="map-svg" viewBox="0 0 420 260" role="img" aria-label="抽象的知识连接图">
          <g class="thread-line">
            <path d="M40 190 C120 40 200 230 280 90 S380 130 400 50" />
            <path d="M60 60 C140 160 230 40 330 170" />
          </g>
          <circle cx="40" cy="190" r="9" fill="var(--tangerine)" />
          <circle cx="140" cy="112" r="14" fill="var(--violet)" />
          <circle cx="280" cy="90" r="11" fill="var(--coral)" />
          <circle cx="330" cy="170" r="8" fill="var(--teal)" />
          <circle cx="400" cy="50" r="6" fill="var(--sky)" />
        </svg>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero-copy { position: relative; z-index: 2; max-width: 62rem; padding-block: 4rem 7rem; }
  .hero-title { margin-top: 1.5rem; }
  .hero-title .line-two { color: var(--accent); }
  .primary-cta,
  .secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    padding: 0.8rem 1.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .primary-cta {
    background: var(--accent);
    color: var(--accent-foreground);
    box-shadow: 0 14px 30px -16px var(--accent);
  }
  .secondary-cta { border: 1px solid var(--border); color: var(--foreground); }
  .primary-cta:hover, .secondary-cta:hover { transform: translateY(-3px); }
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    inset-inline-end: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-accent);
    font-size: 1.4rem;
    color: var(--muted-foreground);
  }
  .cue-line { display: block; width: 3.5rem; height: 1px; background: var(--accent); }
  .now-strip {
    display: grid;
    gap: 1rem;
    border-radius: 1.5rem;
    padding: 1.6rem 1.8rem;
    align-items: center;
  }
  .now-link, .quiet-link {
    color: var(--accent);
    text-decoration: underline dotted;
    text-underline-offset: 5px;
    font-size: 0.88rem;
  }
  .path-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 12rem;
    padding: 1.5rem;
    border-radius: 1.4rem;
    border: 1px solid var(--border);
    background: linear-gradient(150deg, color-mix(in srgb, var(--path-accent) 12%, var(--background)), var(--background));
    text-decoration: none;
    transition: transform 240ms ease, border-color 240ms ease;
  }
  .path-card:hover { transform: translateY(-5px) rotate(-1deg); border-color: var(--path-accent); }
  .path-number { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--muted-foreground); }
  .path-label { margin-top: auto; font-family: var(--font-display); font-size: 1.9rem; font-weight: 600; color: var(--foreground); }
  .path-zh { font-size: 1.35rem; color: var(--path-accent); }
  .path-note { margin-top: 0.5rem; font-size: 0.74rem; color: var(--muted-foreground); }
  .path-arrow { position: absolute; top: 1.2rem; right: 1.4rem; color: var(--path-accent); }
  .garden-map {
    display: grid;
    gap: 2rem;
    border-radius: 1.8rem;
    padding: 2rem;
    align-items: center;
  }
  .map-svg { width: 100%; max-width: 30rem; height: auto; }

  @media (min-width: 900px) {
    .now-strip { grid-template-columns: 1fr 1.6fr auto; }
    .garden-map { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .floating-note { display: none !important; }
    .hero-script { top: 8%; right: 4%; font-size: 2.1rem; opacity: 0.8; }
    .hero-copy { padding-block: 3rem 5rem; }
    .scroll-cue { display: none; }
    .map-svg { max-width: 100%; }
  }
</style>
