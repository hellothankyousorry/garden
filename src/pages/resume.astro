---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import resume from "@/data/resume.json";
import profile from "@/data/profile.json";
import { BASE_PATH } from "@/site.config";

---

<Layout page="resume" title="Resume — A Living Garden" description="教育、经历、技能与成果的时间线。">
  <Header />
  <main id="main-content" class="app-layout flex-1 pb-24 pt-14">
    <div class="resume-heading">
      <div>
        <p class="eyebrow">A linear path, for once</p>
        <h1 class="display resume-title">Résumé<span class="accent-script title-script">the long way around</span></h1>
        <p class="hand-cn resume-cn">{resume.headlineZh}</p>
        <p class="mt-5 max-w-2xl text-sm leading-7 text-muted-foreground">{resume.summary}</p>
      </div>
      <div class="resume-actions no-print">
        <button type="button" id="print-btn" class="print-btn">打印 / 保存 PDF ↗</button>
        <a class="quiet-link" href={`${BASE_PATH}/about/`}>更多关于我 →</a>
      </div>
    </div>

    <div class="resume-grid">
      <section class="timeline-column">
        {
          resume.groups.map(group => (
            <section class="resume-group">
              <h2 class="group-title">{group.title}</h2>
              <div class="timeline">
                {group.items.map(item => (
                  <article class="timeline-item">
                    <p class="period">{item.period}</p>
                    <h3>{item.title}</h3>
                    <p class="org">{item.org}</p>
                    <p class="detail">{item.detail}</p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </section>

      <aside class="resume-side">
        <div class="glass side-card">
          <p class="eyebrow">Contact</p>
          <p class="side-name">{profile.name}</p>
          <p class="side-role">{profile.role}</p>
          <p class="side-line">{profile.location}</p>
          <a class="side-line" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>

        <div class="paper-card side-card">
          <p class="eyebrow">Skills</p>
          {resume.skills.map(skill => (
            <div class="skill-group">
              <h3>{skill.category}</h3>
              <div class="chips">{skill.items.map(item => <span>{item}</span>)}</div>
            </div>
          ))}
        </div>

        <div class="side-card side-note">
          <span class="accent-script">keep growing</span>
          <p>履历只记录已经发生的事；<a href={`${BASE_PATH}/now/`}>Now</a> 记录正在发生的。</p>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .resume-heading { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .resume-title { position: relative; margin-top: 0.7rem; font-size: clamp(3.5rem, 10vw, 7rem); }
  .title-script { position: absolute; left: 0.4rem; top: 106%; bottom: auto; font-size: clamp(1.8rem, 4vw, 2.8rem); transform: rotate(-3deg); transform-origin: left center; white-space: nowrap; }
  .resume-cn { margin-top: 3.4rem; font-size: clamp(1.4rem, 3vw, 2.1rem); color: var(--accent); }
  .resume-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .print-btn {
    border-radius: 999px;
    padding: 0.75rem 1.3rem;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.85rem;
  }
  .quiet-link { font-size: 0.85rem; color: var(--accent); text-decoration: underline dotted; text-underline-offset: 4px; }

  .resume-grid { display: grid; gap: 3.5rem; margin-top: 4.5rem; align-items: start; }
  .resume-group + .resume-group { margin-top: 3.5rem; }
  .group-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .timeline { margin-top: 1.8rem; }
  .timeline-item { position: relative; padding-bottom: 2rem; }
  .period { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--accent); text-transform: uppercase; }
  .timeline-item h3 { margin-top: 0.35rem; font-size: 1.1rem; font-weight: 600; }
  .org { margin-top: 0.2rem; font-size: 0.85rem; color: var(--muted-foreground); }
  .detail { margin-top: 0.5rem; font-size: 0.85rem; line-height: 1.7; color: var(--muted-foreground); }

  .resume-side { display: grid; gap: 1rem; }
  .side-card { border-radius: 1.3rem; padding: 1.4rem; }
  .side-name { margin-top: 0.8rem; font-family: var(--font-display); font-size: 1.5rem; }
  .side-role, .side-line { margin-top: 0.3rem; font-size: 0.8rem; color: var(--muted-foreground); }
  .side-line { display: block; color: var(--accent); text-decoration: none; }
  .skill-group + .skill-group { margin-top: 1.2rem; }
  .skill-group h3 { font-size: 0.8rem; color: var(--muted-foreground); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
  .chips span { padding: 0.2rem 0.6rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.7rem; }
  .side-note { background: color-mix(in srgb, var(--teal) 10%, var(--background)); }
  .side-note p { margin-top: 0.6rem; font-size: 0.82rem; line-height: 1.7; }
  .side-note a { color: var(--accent); text-decoration: underline dotted; }

  @media (min-width: 900px) { .resume-grid { grid-template-columns: minmax(0, 1fr) 19rem; } }
</style>

<script>
  document.querySelector<HTMLButtonElement>("#print-btn")?.addEventListener("click", () => window.print());
</script>
